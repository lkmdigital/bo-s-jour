#!/bin/bash
# =============================================================================
# deployback — Déploiement rapide Backend (Laravel) uniquement
# Usage: ./deployback
#
# Déploie uniquement les modifications du backend sans toucher au frontend
# =============================================================================

set -euo pipefail

# ─── Couleurs ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log()     { echo -e "${GREEN}[$(date '+%H:%M:%S')] ✓${NC} $*"; }
info()    { echo -e "${BLUE}[$(date '+%H:%M:%S')] ℹ${NC} $*"; }
warn()    { echo -e "${YELLOW}[$(date '+%H:%M:%S')] ⚠${NC} $*"; }
error()   { echo -e "${RED}[$(date '+%H:%M:%S')] ✗ ERREUR:${NC} $*" >&2; }
section() { echo -e "\n${BOLD}${CYAN}══ $* ══${NC}\n"; }
die()     { error "$*"; exit 1; }

# ─── Charger la configuration ─────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/deploy.config"

[[ -f "$CONFIG_FILE" ]] || die "Fichier deploy.config introuvable."

# Valeurs par défaut
SERVER=""
SERVER_PASS=""
BACKEND_DIR=""
PHP_SERVICE="php8.2-fpm"

source "$CONFIG_FILE"

[[ -n "$SERVER" ]]       || die "SERVER non défini dans deploy.config"
[[ -n "$BACKEND_DIR" ]]  || die "BACKEND_DIR non défini dans deploy.config"

LOCAL_BACKEND="$SCRIPT_DIR/backend"

# ─── Commandes SSH/Rsync ─────────────────────────────────────────────────────
ssh_exec() {
    if [[ -n "$SERVER_PASS" ]]; then
        sshpass -p "$SERVER_PASS" ssh \
            -o StrictHostKeyChecking=no \
            -o ConnectTimeout=30 \
            -o PubkeyAuthentication=no \
            -o PasswordAuthentication=yes \
            "$SERVER" "$@"
    else
        ssh "$SERVER" "$@"
    fi
}

rsync_exec() {
    if [[ -n "$SERVER_PASS" ]]; then
        sshpass -p "$SERVER_PASS" rsync \
            -e "ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PasswordAuthentication=yes" \
            "$@"
    else
        rsync "$@"
    fi
}

# ─── Vérification SSH ─────────────────────────────────────────────────────────
check_ssh() {
    section "Vérification connexion SSH"
    info "Connexion à $SERVER..."

    if [[ -n "$SERVER_PASS" ]]; then
        sshpass -p "$SERVER_PASS" ssh \
            -o StrictHostKeyChecking=no \
            -o ConnectTimeout=15 \
            -o PubkeyAuthentication=no \
            -o PasswordAuthentication=yes \
            "$SERVER" "echo ok" > /dev/null 2>&1 \
            || die "Connexion échouée. Vérifiez SERVER et SERVER_PASS"
    else
        ssh -o BatchMode=yes -o ConnectTimeout=10 "$SERVER" "echo ok" > /dev/null 2>&1 \
            || die "Connexion SSH échouée. Vérifiez votre clé SSH."
    fi

    log "Connexion SSH OK"
}

# ─── BACKEND ───────────────────────────────────────────────────────────────────
deploy_backend() {
    section "Déploiement Backend (Laravel)"

    [[ -d "$LOCAL_BACKEND" ]] || die "Dossier backend introuvable: $LOCAL_BACKEND"

    # Backup
    local TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
    local BACKUP_PATH="/var/www/backups/backend-${TIMESTAMP}"
    info "Backup → $BACKUP_PATH"
    ssh_exec "
        mkdir -p /var/www/backups
        if [ -d '$BACKEND_DIR' ]; then
            rsync -a --exclude='storage/logs' --exclude='storage/framework/cache' \
                  '$BACKEND_DIR/' '$BACKUP_PATH/'
            ls -dt /var/www/backups/backend-* 2>/dev/null | tail -n +4 | xargs rm -rf 2>/dev/null || true
        fi
    "

    # Transfert
    info "Transfert des fichiers backend..."
    rsync_exec -az --delete \
        --exclude='vendor/' \
        --exclude='.git/' \
        --exclude='storage/app/public/' \
        --exclude='storage/logs/*' \
        --exclude='storage/framework/cache/*' \
        --exclude='storage/framework/sessions/*' \
        --exclude='storage/framework/views/*' \
        --exclude='bootstrap/cache/*' \
        --exclude='.env' \
        --exclude='*.tar.gz' \
        --exclude='*.md' \
        --exclude='*.sh' \
        --exclude='.DS_Store' \
        --exclude='2fa-files-to-upload/' \
        --exclude='email-files-to-upload/' \
        --exclude='files-to-upload/' \
        "$LOCAL_BACKEND/" "$SERVER:$BACKEND_DIR/"
    log "Fichiers transférés"

    # Configuration serveur
    info "Configuration sur le serveur..."
    ssh_exec bash << 'ENDSSH'
        set -e
        cd $BACKEND_DIR

        # 1. CRÉER TOUS LES DOSSIERS NÉCESSAIRES
        echo "→ Création des dossiers..."
        mkdir -p storage/framework/{sessions,views,cache} 
        mkdir -p storage/logs 
        mkdir -p storage/app/public 
        mkdir -p bootstrap/cache
        
        # 2. INSTALLER LES DÉPENDANCES
        echo "→ Installation Composer..."
        composer install --optimize-autoloader --no-dev --no-interaction --quiet
        
        # 3. CORRIGER LES PERMISSIONS (PROBLÈME CRITIQUE POUR UPLOAD)
        echo "→ Correction des permissions..."
        
        # Détecter l'utilisateur PHP-FPM
        PHP_USER=$(ps aux | grep -E "php.*fpm" | grep -v grep | head -1 | awk '{print $1}')
        PHP_USER=${PHP_USER:-www-data}
        echo "  Utilisateur PHP détecté: $PHP_USER"
        
        # Chown récursif sur storage et bootstrap
        chown -R $PHP_USER:$PHP_USER storage bootstrap/cache 2>/dev/null || \
        chown -R www-data:www-data storage bootstrap/cache 2>/dev/null || \
        chown -R 33:33 storage bootstrap/cache 2>/dev/null || true
        
        # Permissions 777 sur storage/app/public (nécessaire pour créer les sous-dossiers d'upload)
        chmod -R 777 storage/app/public
        
        # Permissions 777 sur storage/logs (nécessaire pour créer les fichiers de log)
        chmod -R 777 storage/logs
        
        # Permissions standard sur les autres dossiers
        chmod -R 775 storage/framework bootstrap/cache
        
        # S'assurer que le groupe peut écrire partout
        chmod -R g+w storage bootstrap/cache 2>/dev/null || true
        
        # 4. MIGRATIONS
        echo "→ Migrations..."
        php artisan migrate --force

        # 5. STORAGE LINK
        echo "→ Storage link..."
        rm -f public/storage 2>/dev/null || true
        php artisan storage:link 2>/dev/null || true
        
        # Corriger aussi le lien symbolique vers storage/app/public
        if [ -d "public/storage" ]; then
            chown -R $PHP_USER:$PHP_USER public/storage 2>/dev/null || true
            chmod -R 777 public/storage 2>/dev/null || true
        fi

        # 6. CLEAR CACHES
        echo "→ Nettoyage des caches..."
        php artisan cache:clear 2>/dev/null || true
        php artisan config:clear 2>/dev/null || true
        php artisan route:clear 2>/dev/null || true
        php artisan view:clear 2>/dev/null || true
        php artisan clear-compiled 2>/dev/null || true

        # 7. RECRÉER LES CACHES
        echo "→ Création des caches..."
        php artisan config:cache
        php artisan route:cache
        php artisan view:cache
        php artisan optimize
        
        # 8. PERMISSIONS FINALES
        echo "→ Permissions finales..."
        chmod -R 777 storage/app/public 2>/dev/null || true
        chmod -R 777 storage/logs 2>/dev/null || true

        # 9. RELOAD PHP-FPM
        systemctl reload $PHP_SERVICE 2>/dev/null || \
        systemctl restart $PHP_SERVICE 2>/dev/null || \
        service php-fpm restart 2>/dev/null || true
        
        echo "✓ Backend OK"
ENDSSH

    log "Backend déployé avec succès"
}

# ─── MAIN ─────────────────────────────────────────────────────────────────────
echo -e "\n${BOLD}${CYAN}🚀 DeployBack — Backend uniquement [$(date '+%d/%m/%Y %H:%M')]${NC}\n"
echo -e "  Serveur : ${BOLD}$SERVER${NC}"
echo -e "  Source  : ${BOLD}$LOCAL_BACKEND${NC}"
echo ""

check_ssh
deploy_backend

echo ""
echo -e "${GREEN}✅ Backend déployé !${NC}"
echo ""
