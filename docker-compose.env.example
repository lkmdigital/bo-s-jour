# Variables pour docker-compose — copier en ".env" à la racine du projet avant de lancer
# `docker compose up`. Ce fichier n'est PAS le .env de Laravel (backend/.env) ni celui de
# Next.js (frontend/.env.local) — c'est celui que docker-compose lit lui-même pour
# substituer les ${VARIABLES} dans docker-compose.yml et alimenter chaque conteneur.
#
#   cp docker-compose.env.example .env

# ─── MySQL ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_local_only
MYSQL_DATABASE=monbeaupays
MYSQL_USER=monbeaupays
MYSQL_PASSWORD=change_me_local_only

# ─── Laravel (backend) ────────────────────────────────────────────────────
# Générer avec : docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

FRONTEND_URL=http://localhost:3000

# En local Docker (un seul hôte, pas de sous-domaine bosejour.ci/api.bosejour.ci),
# laisser à "null" — pas de vrai domaine commun entre front et back ici.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost

# CACHE_STORE=redis évite le risque de deadlock MySQL sous forte concurrence
# découvert lors des tests de charge k6 du 2026-08-31 (voir backend/tests/load/README.md)
# — Redis est déjà dans ce docker-compose, autant s'en servir dès le local.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

# MaliaPay — SANDBOX=true par défaut ici, volontairement : aucun risque d'appel
# opérateur réel depuis un environnement Docker local. Renseigner API_KEY/MERCHANT_ID
# uniquement si tu veux tester contre le vrai bac à sable MaliaPay.
MALIA_PAY_API_URL=https://business.malia.ci/api
MALIA_PAY_API_KEY=
MALIA_PAY_MERCHANT_ID=
MALIA_PAY_SANDBOX=true
MALIA_PAY_WEBHOOK_SECRET=

# MAIL_MAILER=log par défaut — écrit les e-mails dans les logs au lieu de les envoyer
# réellement. Ne JAMAIS mettre smtp ici avec de vrais identifiants sans y penser à deux
# fois : un dry-run local enverrait de vrais e-mails (leçon apprise le 2026-09-01).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=dev@bosejour.local
MAIL_FROM_NAME=Bosejour

# ─── Next.js (frontend) — inlinées au build, pas au runtime ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_ONESIGNAL_APP_ID=
