APP_NAME="Bosejour"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://bosejour.ci
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# EN PRODUCTION : mettre ".bosejour.ci" (avec le point en tête) — indispensable pour que le
# cookie de session posé par api.bosejour.ci soit aussi envoyé par le navigateur vers
# bosejour.ci (le frontend). Sans le point en tête, le cookie ne serait valable que pour
# api.bosejour.ci exactement, et la connexion par cookie (migration 2026-08-31) ne
# fonctionnerait jamais depuis le site principal. En local (localhost:3000/:8000), laisser
# à "null" : ce ne sont pas de vrais sous-domaines d'un domaine commun.
SESSION_DOMAIN=null
# Absente = pas de flag Secure sur le cookie de session (Laravel n'active pas HTTPS-only par
# défaut) — à mettre à true en production (le site n'est servi qu'en HTTPS).
SESSION_SECURE_COOKIE=true

# Domaines autorisés à s'authentifier par cookie de session (Sanctum SPA) plutôt que par
# token Bearer — doit inclure le domaine du FRONTEND (pas juste l'API). En prod : bosejour.ci
# et www.bosejour.ci. Un appelant hors de cette liste (script externe, futur client mobile)
# continue de s'authentifier par token Bearer classique, sans conflit.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000,bosejour.ci,www.bosejour.ci

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USERNAME=your_mailjet_api_key
MAIL_PASSWORD=your_mailjet_secret_key
MAIL_SCHEME=
MAIL_FROM_ADDRESS="bosejour@bosejour.ci"
MAIL_FROM_NAME="Bosejour"

CORS_ALLOWED_ORIGINS=https://bosejour.ci,https://www.bosejour.ci

# Tarification automatique des chambres (%)
PRICING_NON_REFUNDABLE_DISCOUNT=10
PRICING_MODIFIABLE_SURCHARGE=10
PRICING_LONG_STAY_DISCOUNT=15
PRICING_LONG_STAY_NIGHTS=7

CLOUDINARY_URL=
GOOGLE_MAPS_API_KEY=

# Passerelle de paiement Malia Pay (Wave, Orange Money, Visa/Mastercard, Djamo)
# MALIA_PAY_MERCHANT_ID et MALIA_PAY_AGGREGATED_MERCHANT_ID ont un repli codé
# en dur dans config/services.php (identifiants historiques du projet) — à
# migrer ici lors du prochain changement de compte marchand. Sans
# MALIA_PAY_WEBHOOK_SECRET, le webhook de paiement accepte les notifications
# sans vérification de signature (voir PaymentController::verifyWebhookSignature) :
# à renseigner impérativement en production.
MALIA_PAY_API_URL=https://malia-pay.com/api/v1/OnlinePaymentService/add_payer
MALIA_PAY_MERCHANT_ID=
MALIA_PAY_AGGREGATED_MERCHANT_ID=
MALIA_PAY_WEBHOOK_SECRET=

# Connexion Google (bouton "Se connecter avec Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Connexion Microsoft (bouton "Se connecter avec Microsoft")
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# OneSignal Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

ONESIGNAL_API_URL=https://onesignal.com/api/v1/notifications
ONESIGNAL_EMAIL_ENABLED=false
ONESIGNAL_FROM_EMAIL=contact@bosejour.ci
ONESIGNAL_FROM_NAME=Bosejour

# SMS.to (envoi OTP / notifications par SMS)
SMSTO_ENABLED=true
SMSTO_API_KEY=
SMSTO_API_URL=https://api.sms.to/sms/send
SMSTO_SENDER_ID=Bosejour
SMSTO_DEFAULT_COUNTRY_CODE=225

# Module IA — Assistant IA Administrateur (Claude / Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

